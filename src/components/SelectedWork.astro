---
import { selectedWork } from '../data/cv';
---

<ol class="work">
  {
    selectedWork.map((w, i) => (
      <li>
        <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <div class="body">
          <div class="head">
            <h3>{w.title}</h3>
            <span class="context">{w.context}</span>
          </div>
          <p>{w.text}</p>
          <ul class="tags" aria-label="Technologies">
            {w.tags.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .work {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: w;
  }
  .work > li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.5rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
  }
  .num {
    font: 0.75rem/2.3 var(--mono);
    color: var(--accent);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.1rem 1rem;
  }
  h3 {
    margin: 0;
    font-size: 1.2rem;
  }
  .context {
    font: 0.72rem var(--mono);
    color: var(--faint);
    white-space: nowrap;
  }
  p {
    margin: 0.3rem 0 0.6rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .tags li {
    font-size: 0.75rem;
    padding: 0.1rem 0.5rem;
    border-radius: 6px;
    background: var(--surface);
    color: var(--muted);
  }
  @media (max-width: 480px) {
    .work > li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .num {
      line-height: 1.6;
    }
  }
</style>
