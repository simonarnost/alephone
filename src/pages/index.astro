---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ProjectList from '../components/ProjectList.astro';
import { now, inline } from '../data/cv';
import portrait from '../assets/portrait.jpeg';
import { SITE, SOCIALS, url } from '../site';

const posts = (await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---

<Base>
  <section class="hero rise">
    <p class="kicker">ℵ₁ — {SITE.location}</p>
    <h1 class="page-title">Šimon <em>Arnošt</em></h1>
    <p class="lede">
      I'm a software engineer in Prague. I work mostly on backend services and databases. Lately
      I'm learning Rust and reading about storage engines.
    </p>
  </section>

  <section class="about rise">
    <figure class="portrait">
      <Image src={portrait} alt="Portrait of Šimon Arnošt" widths={[240, 480]} sizes="240px" loading="eager" />
    </figure>
    <div class="bio">
      <p>
        I spent five years at <a href="https://www.make.com">Make</a>, a workflow automation
        platform. I started in QA and ended up owning production TypeScript and Node.js services on
        AWS and Kubernetes.
      </p>
      <p>
        Most of that work was backend services, PostgreSQL, and event-driven systems. More in my <a
          href={url('cv/')}>CV</a>.
      </p>
    </div>
  </section>

  <section class="block rise">
    <h2 class="kicker">Now</h2>
    <ul class="now">
      {now.map((n) => <li set:html={inline(n)} />)}
    </ul>
  </section>

  <section class="block rise">
    <h2 class="kicker">Projects</h2>
    <ProjectList />
  </section>

  {
    posts.length > 0 && (
      <section class="block rise">
        <h2 class="kicker">Writing</h2>
        <PostList posts={posts} />
      </section>
    )
  }

  <section class="block rise">
    <h2 class="kicker">Elsewhere</h2>
    <ul class="links">
      {
        SOCIALS.map((s) => (
          <li>
            <a href={s.url} rel="me noopener" target={s.url.startsWith('http') ? '_blank' : undefined}>
              <span class="label">{s.name}</span>
              <span class="handle">{s.handle}</span>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .hero .page-title {
    font-size: clamp(3.25rem, 13vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    margin-bottom: 1.5rem;
  }
  .lede {
    font-size: clamp(1.2rem, 2.6vw, 1.45rem);
    line-height: 1.5;
    max-width: 34ch;
    margin: 0 0 3.5rem;
    letter-spacing: -0.01em;
  }

  .about {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 2rem;
    align-items: start;
  }
  .portrait {
    margin: 0;
    position: relative;
  }
  .portrait::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 14px;
    border: 1px solid var(--accent);
    translate: 8px 8px;
    z-index: -1;
    transition: translate 0.4s var(--ease);
  }
  .portrait:hover::after {
    translate: 4px 4px;
  }
  .portrait :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 14px;
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.5s var(--ease);
  }
  .portrait:hover :global(img) {
    filter: none;
  }
  .bio {
    color: var(--muted);
  }
  .bio p:first-child {
    margin-top: 0;
  }

  .block {
    margin-top: 4.5rem;
  }
  .block > .kicker {
    margin: 0 0 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .now {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .now li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--muted);
  }
  .now li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .links {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a {
    display: grid;
    grid-template-columns: 7rem 1fr auto;
    align-items: baseline;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .label {
    font-weight: 500;
  }
  .handle {
    font: 0.85rem var(--mono);
    color: var(--faint);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .arrow {
    color: var(--faint);
    transition: transform 0.3s var(--ease), color 0.2s;
  }
  .links a:hover .arrow {
    color: var(--accent);
    transform: translate(3px, -3px);
  }
  .links a:hover .handle {
    color: var(--ink);
  }

  @media (max-width: 560px) {
    .about {
      grid-template-columns: 1fr;
    }
    .portrait {
      max-width: 11rem;
    }
    .links a {
      grid-template-columns: 5.5rem 1fr auto;
    }
  }
</style>
