---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectList from '../components/ProjectList.astro';
import portrait from '../assets/portrait.jpeg';
import { inline } from '../data/cv';
import { now, updated } from '../data/now';
import { SITE, SOCIALS, url } from '../site';

const updatedLabel = new Intl.DateTimeFormat('en-GB', { month: 'short', year: 'numeric' }).format(updated);
const external = SOCIALS.filter((s) => s.name !== 'Email');
const email = SOCIALS.find((s) => s.name === 'Email')!;
---

<Base>
  <section class="hero rise">
    <p class="kicker">ℵ₁ — {SITE.location}</p>
    <h1 class="page-title">Šimon <em>Arnošt</em></h1>
    <p class="lede">
      I'm a software engineer in Prague. I work mostly on backend services and databases. Lately
      I'm learning Rust and reading about storage engines.
    </p>
    <div class="actions">
      <a class="btn primary" href={email.url}>
        <span>Email me</span>
      </a>
      <a class="btn" href={url('cv/')}>CV</a>
      <a class="btn" href={url('cv/#print')}>PDF</a>
      {
        external.map((s) => (
          <a class="btn ghost" href={s.url} target="_blank" rel="me noopener">
            {s.name}
            <span aria-hidden="true">↗</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="about rise">
    <figure class="portrait">
      <Image src={portrait} alt="Portrait of Šimon Arnošt" widths={[240, 480]} sizes="240px" loading="eager" />
    </figure>
    <div class="bio">
      <p>
        I spent five years at <a href="https://www.make.com">Make</a>, a workflow automation
        platform. I started in QA and ended up owning production TypeScript and Node.js services on
        AWS and Kubernetes.
      </p>
      <p>
        Most of that work was backend services, PostgreSQL, and event-driven systems. More in my <a
          href={url('cv/')}>CV</a>.
      </p>
    </div>
  </section>

  <section class="block rise">
    <div class="block-head">
      <h2 class="kicker">Projects</h2>
      <a class="more" href="https://github.com/simonarnost" target="_blank" rel="noopener">GitHub →</a>
    </div>
    <ProjectList />
  </section>

  <section class="block rise">
    <div class="block-head">
      <h2 class="kicker">Now <span class="stamp">· {updatedLabel}</span></h2>
      <a class="more" href={url('now/')}>Now page →</a>
    </div>
    <ul class="now">
      {now.map((n) => <li set:html={inline(n)} />)}
    </ul>
  </section>

</Base>

<style>
  .hero .page-title {
    font-size: clamp(3.25rem, 13vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    padding-top: 0.12em;
    margin-bottom: 1.5rem;
  }
  .lede {
    font-size: clamp(1.2rem, 2.6vw, 1.45rem);
    line-height: 1.5;
    max-width: 34ch;
    margin: 0 0 2rem;
    letter-spacing: -0.01em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 4rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.2s, background-color 0.2s, color 0.2s, transform 0.2s var(--ease);
  }
  .btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .btn:active {
    transform: scale(0.97);
  }
  .btn.primary {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }
  .btn.primary:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }
  .btn.ghost {
    border-color: transparent;
    color: var(--muted);
  }
  .btn.ghost:hover {
    color: var(--accent);
  }

  .about {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 2rem;
    align-items: start;
  }
  .portrait {
    margin: 0;
    position: relative;
  }
  .portrait::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 14px;
    border: 1px solid var(--accent);
    translate: 8px 8px;
    z-index: -1;
    transition: translate 0.4s var(--ease);
  }
  .portrait:hover::after {
    translate: 4px 4px;
  }
  .portrait :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 14px;
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.5s var(--ease);
  }
  .portrait:hover :global(img) {
    filter: none;
  }
  .bio {
    color: var(--muted);
  }
  .bio p:first-child {
    margin-top: 0;
  }

  .block {
    margin-top: 4.5rem;
  }
  .block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
  }
  .block-head .kicker {
    margin: 0;
  }
  .stamp {
    color: var(--faint);
    opacity: 0.8;
  }
  .more {
    font-size: 0.8rem;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .more:hover {
    color: var(--accent);
  }

  .now {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .now li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--muted);
  }
  .now li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  @media (max-width: 560px) {
    .about {
      grid-template-columns: 1fr;
    }
    .portrait {
      max-width: 11rem;
    }
  }
</style>
