---
import Base from '../layouts/Base.astro';
import Cat from '../components/Cat.astro';
import { SOCIALS, url } from '../site';

const external = SOCIALS.filter((s) => s.name !== 'Email');
const email = SOCIALS.find((s) => s.name === 'Email')!;
---

<Base>
  <section class="hero rise">
    <h1 class="page-title">Šimon <em>Arnošt</em></h1>
    <p class="lede">
      Software engineer in Prague. I build backend services and spend too much time thinking about
      databases.
    </p>
    <div class="actions">
      <a class="btn primary" href={email.url}>
        <span>Email me</span>
      </a>
      <a class="btn" href={url('cv/')}>CV</a>
      {
        external.map((s) => (
          <a class="btn ghost" href={s.url} target="_blank" rel="me noopener">
            {s.name}
            <span aria-hidden="true">↗</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="about rise">
    <Cat />
    <div class="bio">
      <p>
        For five years I was at <a href="https://www.make.com">Make</a>. I joined when it was still
        called Integromat, started in QA breaking things on purpose, and ended up owning production
        TypeScript and Node.js services on AWS and Kubernetes.
      </p>
      <p>
        Lately I'm learning Rust by building things, mostly a storage engine called mini-lsm. It
        lives on the <a href={url('projects/')}>projects</a> page with a few other side projects.
      </p>
      <p>
        What I'm reading and working on right now is on the <a href={url('now/')}>now</a> page. The
        longer version of everything is in my <a href={url('cv/')}>CV</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .hero .page-title {
    font-size: clamp(3.5rem, 14vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    padding-top: 0.12em;
    margin-bottom: 1.5rem;
  }
  .lede {
    font-size: clamp(1.2rem, 2.6vw, 1.45rem);
    line-height: 1.5;
    max-width: 40ch;
    margin: 0 0 2rem;
    letter-spacing: -0.01em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 3.5rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.2s, background-color 0.2s, color 0.2s, transform 0.2s var(--ease);
  }
  .btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .btn:active {
    transform: scale(0.97);
  }
  .btn.primary {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }
  .btn.primary:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }
  .btn.ghost {
    padding-inline: 0.6rem;
    border-color: transparent;
    color: var(--muted);
  }
  .btn.ghost:hover {
    color: var(--accent);
  }

  .about {
    display: grid;
    grid-template-columns: 13.5rem 1fr;
    gap: 2rem;
    align-items: center;
  }
  .bio {
    color: var(--muted);
  }
  .bio p:first-child {
    margin-top: 0;
  }
  .bio p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 560px) {
    .about {
      grid-template-columns: 1fr;
    }
    .about :global(.cat) {
      max-width: 13rem;
    }
  }
</style>
