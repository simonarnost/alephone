---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';

const posts = (await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const byYear = Object.entries(Object.groupBy(posts, (p) => String(p.data.date.getFullYear()))).sort(
  ([a], [b]) => Number(b) - Number(a),
);
---

<Base title="Writing">
  <header class="rise">
    <p class="kicker">Writing</p>
    <h1 class="page-title">Notes &amp; <em>essays</em></h1>
  </header>
  <div class="rise">
    {posts.length === 0 && <p class="empty">Nothing here yet.</p>}
    {
      byYear.map(([year, list]) => (
        <section class="year">
          <h2 class="kicker">{year}</h2>
          <PostList posts={list!} />
        </section>
      ))
    }
  </div>
</Base>

<style>
  .year {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1rem;
    border-top: 1px solid var(--line);
    padding-top: 0.5rem;
    margin-bottom: 2rem;
  }
  .year > .kicker {
    margin: 1.1rem 0 0;
  }
  .empty {
    color: var(--muted);
  }
  @media (max-width: 560px) {
    .year {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
