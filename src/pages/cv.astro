---
import Base from '../layouts/Base.astro';
import CvEntry from '../components/CvEntry.astro';
import { experience, education } from '../data/cv';
import { SITE, SOCIALS } from '../site';
---

<Base title="CV" description="Experience and education of Šimon Arnošt.">
  <header class="rise">
    <p class="print-name">{SITE.title}</p>
    <p class="kicker">Curriculum vitae</p>
    <h1 class="page-title">Work &amp; <em>study</em></h1>
    <p class="contact">
      <span>{SITE.location}</span>
      {SOCIALS.map((s) => <a href={s.url}>{s.name === 'Email' ? s.handle : s.name}</a>)}
    </p>
  </header>

  <div class="cv rise">
    <section>
      <h2 class="kicker">Experience</h2>
      <div class="stack">{experience.map((e) => <CvEntry entry={e} />)}</div>
    </section>

    <section>
      <h2 class="kicker">Education</h2>
      <div class="stack">{education.map((e) => <CvEntry entry={e} />)}</div>
    </section>
  </div>
</Base>

<style>
  .page-title {
    margin-bottom: 1rem;
  }
  .print-name {
    display: none;
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    margin: 0 0 3rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .cv section {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: 2rem;
    border-top: 1px solid var(--line);
  }
  .cv section > .kicker {
    margin: 0.55rem 0 0;
    position: sticky;
    top: 1.5rem;
    align-self: start;
  }
  .stack {
    display: grid;
    gap: 2.75rem;
  }

  @media (max-width: 640px) {
    .cv section {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }
    .cv section > .kicker {
      position: static;
    }
  }
  @media print {
    .print-name {
      display: block;
      font: 400 2.25rem/1 var(--serif);
      margin: 0 0 0.5rem;
    }
    .page-title {
      display: none;
    }
    .cv section {
      padding-block: 1.25rem;
    }
    .cv :global(.roles > li) {
      break-inside: avoid;
    }
  }
</style>
