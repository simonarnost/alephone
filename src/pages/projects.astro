---
import Base from '../layouts/Base.astro';
import ProjectList from '../components/ProjectList.astro';
---

<Base title="Projects" description="Side projects by Šimon Arnošt.">
  <header class="rise">
    <h1 class="kicker">Projects</h1>
  </header>
  <div class="rise">
    <ProjectList />
    <p class="more">
      More on <a href="https://github.com/simonarnost" target="_blank" rel="noopener">GitHub ↗</a>
    </p>
  </div>
</Base>

<style>
  header .kicker {
    margin: 0 0 1.25rem;
  }
  .more {
    margin-top: 2rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
</style>
